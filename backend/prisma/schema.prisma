// ==============================================
// BizPilot AI — Prisma Schema
// PostgreSQL
// ==============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================
// AUTH / USERS
// ==============================================

enum UserRole {
  OWNER
  STAFF
}

model User {
  id           String   @id @default(cuid())
  businessName String
  name         String
  email        String   @unique
  password     String
  role         UserRole @default(OWNER)
  currency     String   @default("NGN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers          Customer[]
  categories         Category[]
  products           Product[]
  sales              Sale[]
  expenses           Expense[]
  expenseCategories  ExpenseCategory[]
  invoices           Invoice[]
  receipts           Receipt[]
  supplierAgreements SupplierAgreement[]
  warrantyCertificates WarrantyCertificate[]
  aiChatMessages     AiChatMessage[]

  @@map("users")
}

// ==============================================
// CUSTOMERS
// ==============================================

model Customer {
  id           String   @id @default(cuid())
  userId       String
  name         String
  phone        String?
  email        String?
  address      String?
  outstandingDebt Decimal @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales Sale[]

  @@index([userId])
  @@map("customers")
}

// ==============================================
// INVENTORY
// ==============================================

model Category {
  id        String    @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime  @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([userId, name])
  @@map("categories")
}

model Product {
  id            String   @id @default(cuid())
  userId        String
  categoryId    String?
  name          String
  description   String?
  sku           String?
  barcode       String?
  imageUrl      String?
  costPrice     Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  stockQuantity Int      @default(0)
  lowStockThreshold Int  @default(5)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems  SaleItem[]

  @@index([userId])
  @@index([barcode])
  @@map("products")
}

// ==============================================
// SALES
// ==============================================

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  CREDIT
}

model Sale {
  id            String        @id @default(cuid())
  userId        String
  customerId    String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)
  profit        Decimal       @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(PAID)
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  invoice  Invoice?
  receipt  Receipt?

  @@index([userId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  unitCost   Decimal @db.Decimal(12, 2)
  subtotal   Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@map("sale_items")
}

// ==============================================
// EXPENSES
// ==============================================

model ExpenseCategory {
  id     String @id @default(cuid())
  userId String
  name   String

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, name])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  categoryId  String?
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("expenses")
}

// ==============================================
// BLOCKCHAIN-BACKED TRUST DOCUMENTS
// (Only hashes go on-chain; full content stays off-chain)
// ==============================================

enum ChainStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Invoice {
  id              String      @id @default(cuid())
  userId          String
  saleId          String      @unique
  invoiceNumber   String      @unique
  pdfUrl          String?
  documentHash    String
  txHash          String?
  chainStatus     ChainStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([documentHash])
  @@map("invoices")
}

model Receipt {
  id              String      @id @default(cuid())
  userId          String
  saleId          String      @unique
  receiptNumber   String      @unique
  pdfUrl          String?
  qrCodeUrl       String?
  documentHash    String
  txHash          String?
  chainStatus     ChainStatus @default(PENDING)
  createdAt       DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([documentHash])
  @@map("receipts")
}

model SupplierAgreement {
  id           String      @id @default(cuid())
  userId       String
  supplierName String
  title        String
  fileUrl      String?
  documentHash String
  txHash       String?
  chainStatus  ChainStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentHash])
  @@map("supplier_agreements")
}

model WarrantyCertificate {
  id           String      @id @default(cuid())
  userId       String
  productName  String
  customerName String
  fileUrl      String?
  documentHash String
  txHash       String?
  chainStatus  ChainStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentHash])
  @@map("warranty_certificates")
}

// ==============================================
// AI ASSISTANT
// ==============================================

enum ChatRole {
  USER
  ASSISTANT
}

model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_chat_messages")
}
