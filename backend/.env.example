NODE_ENV=development
PORT=5000

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# CORS
CLIENT_URL="http://localhost:5173"

# Cloudinary — stores product images, invoice/receipt PDFs, and QR codes.
# Dashboard: https://console.cloudinary.com (Cloud name/API key/secret are on
# the home page). Also enable Settings -> Security -> "Allow delivery of PDF
# and ZIP files", or generated invoice/receipt PDFs will 401 when opened.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Gemini AI
GEMINI_API_KEY=""

# News (GNews.io free tier — https://gnews.io)
NEWS_API_KEY=""

# Blockchain (Base Sepolia) — invoices/receipts still generate correctly
# without these set; anchoring just no-ops and chainStatus stays PENDING.
# All three must be real for anchoring to actually work in production:
#   - BASE_SEPOLIA_RPC_URL: defaults to the public sepolia.base.org RPC
#     (verified reachable) if unset. Never point this at a local node
#     (e.g. 127.0.0.1:8545) outside local Hardhat development — that will
#     silently fail every anchor attempt in any deployed environment.
#   - BLOCKCHAIN_PRIVATE_KEY: a wallet actually funded with Base Sepolia
#     testnet ETH (a faucet, e.g. alchemy.com/faucets/base-sepolia).
#     Zero balance = every anchor transaction fails.
#   - TRUST_REGISTRY_CONTRACT_ADDRESS: must be a TrustRegistry contract
#     actually deployed on Base Sepolia (see contracts/scripts/deploy.js).
#     A placeholder/local-Hardhat address has no code on the real network —
#     verifiable yourself with a read-only eth_getCode RPC call.
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BLOCKCHAIN_PRIVATE_KEY=""
TRUST_REGISTRY_CONTRACT_ADDRESS=""

# Cleanverse (CVI/CVA trust layer) — optional. Unset means the app honestly
# reports "Not Connected" everywhere trust status is shown (see
# cleanverseTrust.service.ts) instead of faking verification.
CLEANVERSE_API_URL=""
CLEANVERSE_API_KEY=""
